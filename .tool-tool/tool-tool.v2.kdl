cache-directory ".cache/tool-tool"

tools {
	geist "1.7.0" {
		download {
			linux "https://github.com/vercel/geist-font/releases/download/${version}/geist-font-${version}.zip"
		}
	}

	rumdl "0.2.78" {
		download {
			linux "https://github.com/rvben/rumdl/releases/download/v${version}/rumdl-v${version}-x86_64-unknown-linux-musl.tar.gz"
		}
		commands {
			rumdl "rumdl"
		}
	}
// https://github.com/jgraph/drawio-desktop/releases
	drawio "31.7.0" {
		download {
			linux "https://github.com/jgraph/drawio-desktop/releases/download/v${version}/drawio-x86_64-${version}.AppImage"
		}
		commands {
			drawio "drawio.AppImage"
		}
		env {
			APPIMAGE_EXTRACT_AND_RUN "1"
			DISPLAY "${env:DISPLAY|}"
			WAYLAND_DISPLAY "${env:WAYLAND_DISPLAY|}"
			XAUTHORITY "${env:XAUTHORITY|}"
			XDG_RUNTIME_DIR "${env:XDG_RUNTIME_DIR|}"
			DBUS_SESSION_BUS_ADDRESS "${env:DBUS_SESSION_BUS_ADDRESS|}"
		}
	}
	nao "0.1.7" {
		download {
			linux "https://github.com/manuel-woelker/nao/releases/download/v${version}/nao-v${version}-x86_64-unknown-linux-musl.tar.gz"
		}
		commands {
			nao "nao"
		}
		env {
			DISPLAY "${env:DISPLAY|}"
			WAYLAND_DISPLAY "${env:WAYLAND_DISPLAY|}"
			XAUTHORITY "${env:XAUTHORITY|}"
			XDG_RUNTIME_DIR "${env:XDG_RUNTIME_DIR|}"
			DBUS_SESSION_BUS_ADDRESS "${env:DBUS_SESSION_BUS_ADDRESS|}"
		}
	}
	zig "0.16.0" {
		download {
			linux "https://ziglang.org/download/${version}/zig-x86_64-linux-${version}.tar.xz"
		}
		commands {
			zig "zig"
		}
	}
	cargo-nextest "0.9.144" {
		download {
			linux "https://github.com/nextest-rs/nextest/releases/download/cargo-nextest-${version}/cargo-nextest-${version}-x86_64-unknown-linux-gnu.tar.gz"
		}
		commands {
			cargo-nextest "cargo-nextest"
		}
		env {
			PATH "${dir:rust}/rustc/bin:${dir:rust}/cargo/bin:${dir:rust}/rustfmt-preview/bin:${dir:rust}/clippy-preview/bin:${dir:zig}"
			LD_LIBRARY_PATH "${dir:rust}/rustc/lib"
			PIXUI_GEIST_DIRECTORY "${dir:geist}"
			AR "${dir:rust}/llvm-tools-preview/lib/rustlib/x86_64-unknown-linux-gnu/bin/llvm-ar"
			CC "${base_path}/scripts/zig-cc"
			CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER "${base_path}/scripts/zig-cc"
			RUSTC "${dir:rust}/rustc/bin/rustc"
			RUSTDOC "${dir:rust}/rustc/bin/rustdoc"
			RUSTFLAGS "--sysroot ${dir:rust}/rust-std-x86_64-unknown-linux-gnu"
			RUSTDOCFLAGS "--sysroot ${dir:rust}/rust-std-x86_64-unknown-linux-gnu"
			ZIG_GLOBAL_CACHE_DIR "${base_path}/.cache/zig/global"
			ZIG_LOCAL_CACHE_DIR "${base_path}/.cache/zig/local"
		}
	}
	rust "1.99.0" {
		download {
			linux "https://static.rust-lang.org/dist/rust-${version}-x86_64-unknown-linux-gnu.tar.gz"
		}
		commands {
			cargo "cargo/bin/cargo"
			clippy "clippy-preview/bin/cargo-clippy"
			rustc "rustc/bin/rustc"
			rustfmt "rustfmt-preview/bin/rustfmt"
		}
		env {
			DISPLAY "${env:DISPLAY|}"
			WAYLAND_DISPLAY "${env:WAYLAND_DISPLAY|}"
			XAUTHORITY "${env:XAUTHORITY|}"
			XDG_RUNTIME_DIR "${env:XDG_RUNTIME_DIR|}"
			DBUS_SESSION_BUS_ADDRESS "${env:DBUS_SESSION_BUS_ADDRESS|}"
			PATH "${dir:rust}/rustc/bin:${dir:rust}/cargo/bin:${dir:rust}/rustfmt-preview/bin:${dir:rust}/clippy-preview/bin:${dir:zig}"
			LD_LIBRARY_PATH "${dir:rust}/rustc/lib"
			PIXUI_GEIST_DIRECTORY "${dir:geist}"
			AR "${dir:rust}/llvm-tools-preview/lib/rustlib/x86_64-unknown-linux-gnu/bin/llvm-ar"
			CC "${base_path}/scripts/zig-cc"
			CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER "${base_path}/scripts/zig-cc"
			RUSTC "${dir:rust}/rustc/bin/rustc"
			RUSTDOC "${dir:rust}/rustc/bin/rustdoc"
			RUSTFLAGS "--sysroot ${dir:rust}/rust-std-x86_64-unknown-linux-gnu"
			RUSTDOCFLAGS "--sysroot ${dir:rust}/rust-std-x86_64-unknown-linux-gnu"
			ZIG_GLOBAL_CACHE_DIR "${base_path}/.cache/zig/global"
			ZIG_LOCAL_CACHE_DIR "${base_path}/.cache/zig/local"
		}
	}
}

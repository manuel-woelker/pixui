          <mxGeometry x="20" y="225" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="6" value="&lt;b&gt;ApplicationHandle&lt;/b&gt;&lt;br&gt;&lt;br&gt;One cheaply clonable sender&lt;br&gt;dispatch / try_dispatch&lt;br&gt;add_slice / inspect / object_ref" parent="3" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;spacing=12;">
          <mxGeometry x="20" y="375" width="280" height="105" as="geometry" />
        </mxCell>
        <mxCell id="7" value="&lt;b&gt;Bounded command queue&lt;/b&gt;&lt;br&gt;&lt;br&gt;crossbeam-channel, used as MPSC&lt;br&gt;Default: 128 commands&lt;br&gt;Full: wait or try_dispatch error&lt;br&gt;Capacity zero: rendezvous" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;spacing=12;">
          <mxGeometry x="420" y="515" width="310" height="140" as="geometry" />
        </mxCell>
        <mxCell id="8" value="Application worker · single consumer and sole state owner" parent="1" vertex="1" style="swimlane;html=1;startSize=40;rounded=1;fillColor=#fafafa;strokeColor=#999999;fontSize=16;fontStyle=1;">
          <mxGeometry x="800" y="140" width="570" height="640" as="geometry" />
        </mxCell>
        <mxCell id="9" value="&lt;b&gt;Sequential command execution&lt;/b&gt;&lt;br&gt;&lt;br&gt;Action adapter calls an ordinary handler&lt;br&gt;Resolve &amp;amp;mut Arena&amp;lt;T&amp;gt; or &amp;amp;mut T&lt;br&gt;Inspection returns an owned snapshot" parent="8" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;spacing=12;">
          <mxGeometry x="25" y="60" width="520" height="120" as="geometry" />
        </mxCell>
        <mxCell id="10" value="&lt;b&gt;Application&lt;/b&gt;&lt;br&gt;&lt;br&gt;Owns named slices with stable SliceId&lt;br&gt;Slice names are unique and immutable" parent="8" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;spacing=12;">
          <mxGeometry x="25" y="245" width="240" height="115" as="geometry" />
        </mxCell>
        <mxCell id="11" value="&lt;b&gt;ApplicationSlice&lt;/b&gt;&lt;br&gt;&lt;br&gt;Named collections + action descriptors&lt;br&gt;Validate bindings during registration" parent="8" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;spacing=12;">
          <mxGeometry x="305" y="245" width="240" height="115" as="geometry" />
        </mxCell>
        <mxCell id="12" value="&lt;b&gt;ObjectRef&amp;lt;T&amp;gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Slice + collection + typed key&lt;br&gt;Resolve identity, type and generation&lt;br&gt;64-bit key: index / arena ID / generation" parent="8" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;spacing=12;">
          <mxGeometry x="25" y="430" width="240" height="155" as="geometry" />
        </mxCell>
        <mxCell id="13" value="&lt;b&gt;Collection → Arena&amp;lt;T&amp;gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;One concrete item type per collection&lt;br&gt;Erase the arena once through Any&lt;br&gt;Store items directly; T: static + Send&lt;br&gt;Items need no Reflect or Sync" parent="8" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;spacing=12;">
          <mxGeometry x="305" y="430" width="240" height="155" as="geometry" />
        </mxCell>
        <mxCell id="14" value="&lt;b&gt;Per-command reply channel&lt;/b&gt;&lt;br&gt;&lt;br&gt;Capacity 1 · owned PixuiResult&amp;lt;T&amp;gt;&lt;br&gt;dispatch returns PendingAction; wait receives its result&lt;br&gt;Dropping the reply does not cancel execution" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;spacing=12;">
          <mxGeometry x="420" y="720" width="310" height="140" as="geometry" />
        </mxCell>
        <mxCell id="15" value="&lt;b&gt;Lifecycle and execution limits&lt;/b&gt;&lt;br&gt;&lt;br&gt;Last sender dropped → drain accepted commands → exit; no join acknowledgment.&lt;br&gt;Unwinding panic → discard state and drop later commands so callers receive errors.&lt;br&gt;Handler errors do not roll back mutations; long commands delay all later work.&lt;br&gt;Never call blocking handles from this worker: it cannot service its own queue." parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;spacing=12;">
          <mxGeometry x="30" y="900" width="1340" height="125" as="geometry" />
        </mxCell>

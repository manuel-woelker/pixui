        <mxCell id="4" value="&lt;b&gt;Generated slice facade&lt;/b&gt;&lt;br&gt;&lt;br&gt;Typed methods, e.g. TodoActions.add_todo&lt;br&gt;Clonable; waits for each result&lt;br&gt;String parameters use Into&amp;lt;String&amp;gt;" parent="3" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;spacing=12;">

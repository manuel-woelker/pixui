        <mxCell id="2" value="&lt;b&gt;Application runtime&lt;/b&gt;&lt;br&gt;&lt;br&gt;Multiple callers send owned commands; one worker owns and mutates application state." parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;spacing=12;">
          <mxGeometry x="30" y="20" width="1340" height="80" as="geometry" />

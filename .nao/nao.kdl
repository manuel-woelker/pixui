recipe "default" {
  task "build" description="Build the workspace" {
    run shell="""
      cargo build \
        --workspace \
        --all-targets \
        --all-features
    """
  }

  task "fmt" description="Check code formatting" {
    run shell="""
      cargo fmt \
        --all
    """
  }

  task "clippy" description="Run clippy across the workspace" {
    depends-on "build"
    run shell="""
      cargo clippy \
        --workspace \
        --all-targets \
        --all-features \
        -- \
        -D warnings
    """
  }

  task "test" description="Run the test suite" {
    depends-on "build"
    run shell="""
      TEST_OUTPUT_FILE="$(mktemp)"

      if ! cargo nextest run \
        --workspace \
        --all-targets \
        --all-features \
        --show-progress=none \
        --status-level fail \
        --no-fail-fast \
        >"$TEST_OUTPUT_FILE" 2>&1; then
        cat "$TEST_OUTPUT_FILE"
        rm -f "$TEST_OUTPUT_FILE"
        exit 1
      fi

      cat "$TEST_OUTPUT_FILE"

      EXECUTED_TESTS="$(
        awk '
          /Summary .* tests run:/ {
            if (match($0, / ([0-9]+) tests run:/, matches)) {
              total += matches[1]
            }
          }
          END {
            print total + 0
          }
        ' "$TEST_OUTPUT_FILE"
      )"

      rm -f "$TEST_OUTPUT_FILE"
      printf 'Task outcome: %s tests passed\n' "$EXECUTED_TESTS"
    """
  }

  task "check" description="Run all repository verification tasks" {
    depends-on "fmt"
    depends-on "clippy"
    depends-on "test"
    run shell="""
      printf 'All repository verification tasks completed.\n'
    """
  }

  task "check-code" description="Run the full repository verification task graph" {
    depends-on "check"
    run script="./scripts/check-code.sh"
  }
}
